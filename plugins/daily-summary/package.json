{
  "name": "nooklet-plugin-daily-summary",
  "version": "0.1.0",
  "type": "module",
  "nooklet": {
    "id": "daily-summary",
    "name": "Daily summary",
    "api": "1",
    "server": "./src/server.ts",
    "permissions": [],
    "settings": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
