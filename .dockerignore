# Keeps the deploy/docker/*Dockerfile build contexts small and platform-clean: host node_modules
# (macOS native binaries) must never reach the Linux build stage.
**/node_modules
.git
.claude
**/dist
apps/desktop/sidecar
apps/desktop/.cache
apps/desktop/src-tauri/target
apps/web/ios
e2e/test-results
e2e/playwright-report
apps/site/out
apps/site/.next
