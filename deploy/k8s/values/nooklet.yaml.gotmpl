# DRAFT — not applied. → infra-repo k8s/values/nooklet.yaml.gotmpl
image:
  repository: registry.container-registry:5000/nooklet
  # tag: set by CI with --set-string image.tag=sha-<8 chars> (infra-repo CLAUDE.md: --set-string)
  pullPolicy: IfNotPresent

allowHosts:
  - nooklet.<tailnet>.ts.net

# 32+ random chars, prefixed like the server's own (`nkroot_`), e.g.
#   echo "nkroot_$(openssl rand -hex 24)"
rootToken: {{ .Values.nooklet.rootToken | quote }}

persistence:
  storageClassName: database-storage
  size: 5Gi
