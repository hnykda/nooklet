{
  "name": "@nooklet/site",
  "version": "0.0.1",
  "private": true,
  "description": "nooklet's public landing page and documentation: a Next.js static export that renders docs/guide at build time",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --port 6445",
    "build": "next build && node scripts/emit-raw.ts",
    "serve": "node scripts/serve.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "screenshots": "node scripts/capture-screenshots.ts"
  },
  "dependencies": {
    "minisearch": "7.2.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@shikijs/rehype": "4.5.0",
    "@types/hast": "3.0.4",
    "@types/mdast": "4.0.4",
    "@types/node": "^22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "hast-util-to-string": "3.0.1",
    "rehype-raw": "7.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.5.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.1"
  }
}
